# Apache (большинство shared-хостингов: ps.kz, hoster.kz, Beget и т.п.)
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. www → без www (главное зеркало). Если основной домен с www — поменяйте правило.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 3. Скрытые файлы (.env, .git) — 404
  RewriteRule (^|/)\. - [R=404,L]

  # 4. Всё, что не является файлом, — в index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# router.php нужен только для локальной разработки
<Files "router.php">
  Require all denied
</Files>

<IfModule mod_headers.c>
  Header always unset X-Powered-By
  <FilesMatch "\.(css|js|svg|webp|png|jpg|jpeg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/webp .webp
