# Скопируйте в .env и заполните. Файл .env НЕ коммитится и лежит вне public/.
APP_ENV=production            # production | development
APP_URL=https://example.kz    # основной домен, без слэша на конце (используется в canonical и sitemap)
APP_FORCE_HTTPS=1             # 301-редирект на https
APP_DEBUG=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chemodan
DB_USER=chemodan
DB_PASS=change_me

# Telegram-уведомления о заявках: токен от @BotFather и chat_id (личный или группы)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Можно не трогать. Меняется только в тестах (подмена API на локальный мок)
TELEGRAM_API_BASE=https://api.telegram.org

# Секрет для подписи форм (любая длинная случайная строка, 32+ символа)
APP_SECRET=change_me_to_random_64_chars
